# Copy to .env.local. Never commit .env.local. This repository may be public.

# Postgres on Neon. Pooled connection string with sslmode=require. Locally use
# a development branch. Production reads it from the Vercel environment.
DATABASE_URL=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mail. "log" writes every message to the mail_log table and sends nothing.
# "resend" sends through Resend. Production is the only place that sets resend.
MAIL_PROVIDER=log
MAIL_FROM="Starter Kit <noreply@example.com>"
RESEND_API_KEY=

# The cron route checks this bearer token before it runs. Generate it like the
# auth secret. Vercel sends it automatically once it is set in the project.
CRON_SECRET=

# The seed script creates this person and their organisation, once.
SEED_EMAIL=owner@example.com
SEED_PASSWORD=change-this-before-anyone-else-does
SEED_NAME=Owner
